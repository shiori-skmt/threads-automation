# このファイルを .env にコピーして、実際の値を入力してください
# cp .env.example .env

# 楽天ウェブサービス(RWS) — rakuten-threads-botと共通のものを使う想定
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=

# Threads API — このアカウント(@shibainu_yuzu__)専用のトークン
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Rakuten APIのReferer/Origin制約用(アプリ登録時に許可ドメインへ追加した値。Threadsの実ドメインは threads.com)
RAKUTEN_REFERER=https://threads.com/
